OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Database (Phase 4 persistence)
DATABASE_URL=
DATABASE_SSL_MODE=require
DATABASE_SSL_REJECT_UNAUTHORIZED=true

# Optional Phase 4 protections (enforced only when set)
PORTAL_AGENT_BEARER_TOKEN=
SIMULATOR_BEARER_TOKEN=
ANALYTICS_INGEST_TOKEN=

# Optional client token for analytics ingestion header
NEXT_PUBLIC_ANALYTICS_INGEST_TOKEN=
NEXT_PUBLIC_BE_URL=https://be.zakaa.io/login

# Async jobs + incident integrations (B4/B5)
INCIDENT_NOTIFICATION_COOLDOWN_MS=600000
INCIDENT_SLACK_WEBHOOK_URL=
INCIDENT_WEBHOOK_URL=
INCIDENT_WEBHOOK_TOKEN=
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_EVENT_URL=https://events.pagerduty.com/v2/enqueue
INCIDENT_EMAIL_WEBHOOK_URL=
INCIDENT_EMAIL_WEBHOOK_TOKEN=
INCIDENT_EMAIL_TO=
INCIDENT_EMAIL_FROM=

# Session auth + RBAC (B1)
SESSION_SECRET=
SESSION_MAX_AGE_SECONDS=28800
AUTH_ADMIN_EMAIL=
AUTH_ADMIN_PASSWORD=
AUTH_OPERATOR_EMAIL=
AUTH_OPERATOR_PASSWORD=
AUTH_VIEWER_EMAIL=
AUTH_VIEWER_PASSWORD=

# Alert thresholds (Phase 4 observability)
ALERT_WARNING_FAILURE_RATE=0.12
ALERT_CRITICAL_FAILURE_RATE=0.25
ALERT_MIN_EVENTS=25
ALERT_MIN_CHAT_TO_LEAD_RATE=0.02
